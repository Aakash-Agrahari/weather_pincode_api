# Server
PORT=3000

# OpenWeather API (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Default country code used to resolve Pincode -> lat/long via
# OpenWeather's Geocoding API (https://openweathermap.org/api/geocoding-api)
DEFAULT_COUNTRY_CODE=IN

# SQLite DB file path (RDBMS storage for pincode + weather cache)
DB_STORAGE_PATH=./data/weather.sqlite

# How long a cached weather record stays "fresh" before we call
# the external API again for the same pincode + date (in minutes)
WEATHER_CACHE_TTL_MINUTES=60
